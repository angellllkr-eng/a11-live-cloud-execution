# A11 Platform Environment Configuration
# Copy to .env and fill in your values

ENV=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/a11

# Google Cloud
GCP_PROJECT=a11-platform
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# Models
PRIMARY_MODEL=gemini-3.7
FALLBACK_MODEL=grok-6
TERTIARY_MODEL=gpt-4-turbo

# Governance
CONFIDENCE_THRESHOLD=0.7
ESCALATION_ENABLED=true

# Caching (optional)
REDIS_URL=redis://localhost:6379

# Monitoring
ENABLE_PROMETHEUS=true
ENABLE_CLOUD_TRACE=true
